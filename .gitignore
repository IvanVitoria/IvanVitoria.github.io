# ---------------------------------------------------------------------------
# IVNV — ivnvmusic.com
#
# Static site served by GitHub Pages from the repo root. Nothing here is built
# today; the Node/Astro blocks are here so the planned Astro port drops in
# without a second round of gitignore churn.
#
# Do NOT add Jekyll entries (_site/, .jekyll-cache/, Gemfile.lock). The live
# site is plain static — see AGENTS.md.
# ---------------------------------------------------------------------------

# --- OS / file explorer ------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes

# Linux
.directory
.fuse_hidden*

# --- Editors / IDEs ----------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~
.history/

# --- Environment & secrets --------------------------------------------
.env
.env.*
!.env.example

# --- Node / Astro (planned stack) -------------------------------------
node_modules/
.npm/
.yarn/
.pnpm-store/
.astro/
dist/
next-env.d.ts

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# --- Build / cache -----------------------------------------------------
.sass-cache/
.cache/
.temp/
tmp/
*.log

# --- Deploy previews ---------------------------------------------------
.vercel/
.netlify/

# --- Impeccable skill output -------------------------------------------
# Runtime artifacts from .agents/skills/impeccable:
#   .impeccable/critique/  saved critique reports
#   .impeccable/review/    screenshots and diff heatmaps
#   .impeccable/build/     comp specs and build state
#   .impeccable/mocks/     generated comps
#   .impeccable/live/      live-session journals
#   .impeccable/config.local.json  per-developer override
# The skill itself (.agents/skills/impeccable/) IS tracked — only its output
# is machine-local.
.impeccable/
