---
import { Image } from 'astro:assets';

import heroImage from '../assets/press/ivnv-profile.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import MusicLedger from '../components/MusicLedger.astro';
import { APPEARANCES } from '../data/appearances';
import { MAD_COOL_SET, MUSIC, YOUTUBE_CHANNEL } from '../data/music';
import { SHOW_TOUR_DATES, SITE } from '../data/site';
import { formatDate } from '../lib/format';
import {
  eventSchemas,
  musicGroupSchema,
  websiteSchema,
} from '../lib/schema';

const jsonLd = [musicGroupSchema(), websiteSchema(), ...eventSchemas()];
const heroProfiles = SITE.socials.filter((profile) =>
  ['ra', 'soundcloud', 'instagram', 'youtube'].includes(profile.icon),
);
const musicRows = MUSIC.slice(0, 10);
const fullSetHref = MAD_COOL_SET?.links.youtube ?? YOUTUBE_CHANNEL;
const typeLabels = {
  club: 'Club night',
  recorded: 'Recorded set',
  private: 'Private event',
} as const;

function appearanceWhen(date: string | undefined, type: string): string {
  if (date) return formatDate(date);
  return type === 'recorded' ? 'Recorded' : 'Private';
}
---

<BaseLayout
  title="IVNV | Techno DJ | Barcelona"
  description={SITE.description}
  type="profile"
  jsonLd={jsonLd}
  markdown="/index.md"
  current="/"
>
  <section class="border-b border-line">
    <div class="mx-auto max-w-page px-4 pb-16 pt-12 md:px-8 lg:px-12 lg:pb-20 lg:pt-16">
      <div class="grid grid-cols-1 items-start gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="flex flex-col justify-between lg:col-span-7">
          <div>
            <p class="mb-5 font-mono text-xs uppercase tracking-[0.16em] text-glow">
              Barcelona // Techno
            </p>
            <h1
              class="mb-6 font-display text-[84px] font-extrabold uppercase leading-[0.82] tracking-[-0.03em] text-ink sm:text-[112px] lg:text-[132px]"
            >
              <span class="block">IVNV</span>{' '}
              <span
                class="mt-6 block border-l-2 border-ember pl-4 font-mono text-[15px] font-normal normal-case leading-normal tracking-[0.08em] text-ink sm:text-[17px]"
              >
                Techno DJ — Barcelona
              </span>
            </h1>

            <div class="mb-8 max-w-xl space-y-4 text-[16px] leading-[1.65] text-body sm:text-[17px]">
              {SITE.bio.map((paragraph) => <p>{paragraph}</p>)}
            </div>

            <a
              href={fullSetHref}
              target="_blank"
              rel="noopener noreferrer"
              class="group mb-10 inline-flex flex-wrap items-center gap-x-3 gap-y-1 border border-line px-3 py-2 font-mono text-xs uppercase tracking-[0.14em] text-muted transition-colors hover:border-glow hover:text-ink"
            >
              <span aria-hidden="true" class="text-glow">●</span>
              <span class="text-ink">Mad Cool DJ Talent 2026</span>
              <span>Top 50 finalist</span>
              <span aria-hidden="true" class="text-glow transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5">
                ↗
              </span>
              <span class="sr-only">(opens in a new tab)</span>
            </a>

            <div class="flex flex-wrap items-center gap-3">
              <a
                href="/#booking"
                class="inline-block bg-ink px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.14em] text-black transition-colors hover:bg-body"
              >
                Booking →
              </a>
              <a
                href="/press-kit/"
                class="inline-block border border-ink px-5 py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-colors hover:border-glow hover:text-glow"
              >
                Press kit (EPK) →
              </a>
              {SHOW_TOUR_DATES && (
                <a
                  href="#tour-dates"
                  class="inline-block border border-line-strong px-5 py-3 font-mono text-xs uppercase tracking-[0.14em] text-body transition-colors hover:border-glow hover:text-glow"
                >
                  Tour dates →
                </a>
              )}
              <a
                href="#music"
                class="inline-block border border-line-strong px-5 py-3 font-mono text-xs uppercase tracking-[0.14em] text-body transition-colors hover:border-glow hover:text-glow"
              >
                Music →
              </a>
            </div>
          </div>

          <div class="mt-12 border-t border-line pt-4">
            <div
              class="flex flex-col gap-3 font-mono text-xs uppercase tracking-[0.14em] sm:flex-row sm:items-center sm:justify-between"
            >
              <span class="text-muted">Platforms:</span>
              <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
                {
                  heroProfiles.map((profile) => (
                    <a
                      href={profile.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-1.5 text-body transition-colors hover:text-glow"
                    >
                      {profile.label}
                      <span aria-hidden="true" class="text-glow">↗</span>
                      <span class="sr-only">(opens in a new tab)</span>
                    </a>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div class="mx-auto w-full max-w-md lg:col-span-5 lg:max-w-none">
          <div class="border border-line-strong bg-base p-2">
            <div class="relative aspect-[3/4] overflow-hidden bg-base">
              <Image
                src={heroImage}
                alt="Portrait of IVNV"
                width={960}
                widths={[480, 720, 960]}
                sizes="(min-width: 1024px) 40vw, 100vw"
                format="webp"
                quality={80}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="music" class="scroll-mt-16 border-b border-line py-16">
    <div class="mx-auto max-w-page px-4 md:px-8 lg:px-12">
      <div class="mb-8 border-b border-line pb-4">
        <p class="mb-1 font-mono text-xs uppercase tracking-[0.14em] text-glow">
          Recorded sets &amp; transmissions
        </p>
        <h2 class="font-display text-[40px] font-extrabold uppercase tracking-tight text-ink sm:text-[48px]">
          Music
        </h2>
      </div>

      <MusicLedger entries={musicRows} />

    </div>
  </section>

  {SHOW_TOUR_DATES && (
  <section id="tour-dates" class="scroll-mt-16 border-b border-line py-16">
    <div class="mx-auto max-w-page px-4 md:px-8 lg:px-12">
      <div class="mb-8 border-b border-line pb-4">
        <p class="mb-1 font-mono text-xs uppercase tracking-[0.14em] text-glow">
          Live // Selected appearances
        </p>
        <h2 class="font-display text-[40px] font-extrabold uppercase tracking-tight text-ink sm:text-[48px]">
          Selected appearances
        </h2>
      </div>

      <div class="mb-8 flex flex-col gap-4 border border-line-strong p-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <p class="font-mono text-xs uppercase tracking-[0.14em] text-glow">
            No upcoming dates announced
          </p>
          <p class="mt-2 max-w-xl text-sm leading-relaxed text-body">
            For bookings and availability, contact
            <a
              href={`mailto:${SITE.email}`}
              class="text-ink underline decoration-line-strong underline-offset-4 hover:text-glow"
            >
              {SITE.email}
            </a>.
          </p>
        </div>
        <a
          href={`mailto:${SITE.email}`}
          class="inline-block shrink-0 border border-line-strong px-5 py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-colors hover:border-glow hover:text-glow"
        >
          Request a date →
        </a>
      </div>

      <div class="border-t border-line-strong">
        {
          APPEARANCES.map((appearance) => (
            <div class="group grid grid-cols-1 gap-2 border-b border-line py-5 pl-3 pr-2 transition-colors hover:bg-panel/40 md:grid-cols-[9rem_minmax(0,1fr)_auto] md:items-center md:gap-6">
              <span class="font-mono text-xs uppercase tracking-[0.12em] text-glow">
                {appearanceWhen(appearance.date, appearance.type)}
              </span>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="font-mono text-sm font-bold uppercase tracking-[0.04em] text-ink">
                  {appearance.venue}
                </span>
                <span class="font-mono text-xs uppercase tracking-[0.12em] text-muted">
                  {appearance.city}
                </span>
                <span class="font-mono text-xs uppercase tracking-[0.12em] text-muted">
                  // {typeLabels[appearance.type]}
                </span>
              </div>
              {appearance.href ? (
                <a
                  href={appearance.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-body transition-colors hover:text-glow md:justify-end"
                >
                  Details
                  <span aria-hidden="true" class="text-glow">↗</span>
                  <span class="sr-only">(opens in a new tab)</span>
                </a>
              ) : (
                <span class="font-mono text-xs uppercase tracking-[0.12em] text-muted md:text-right">
                  Archive
                </span>
              )}
            </div>
          ))
        }
      </div>
    </div>
  </section>
  )}

  <section id="booking" class="scroll-mt-16 py-20">
    <div class="mx-auto max-w-page px-4 md:px-8 lg:px-12">
      <div class="mb-12 border-b border-line pb-4">
        <p class="mb-1 font-mono text-xs uppercase tracking-[0.14em] text-glow">
          Get in touch
        </p>
        <h2 class="font-display text-[40px] font-extrabold uppercase tracking-tight text-ink sm:text-[52px]">
          Booking &amp; contact
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-12 lg:grid-cols-12 lg:gap-16">
        <div class="lg:col-span-6 lg:border-r lg:border-line lg:pr-10">
          <p class="mb-3 font-mono text-xs uppercase tracking-[0.14em] text-muted">
            Direct inquiries
          </p>
          <a
            href={`mailto:${SITE.email}`}
            class="mb-8 block break-all font-mono text-[24px] font-bold text-ink transition-colors hover:text-glow sm:text-[30px]"
          >
            {SITE.email}
          </a>
          <p class="mb-8 max-w-md text-[15px] leading-[1.6] text-muted">
            For club nights, private events and collaborations.
          </p>
          <a
            href={`mailto:${SITE.email}`}
            class="inline-block bg-ink px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.14em] text-black transition-colors hover:bg-body"
          >
            Send a booking inquiry →
          </a>
        </div>

        <div class="lg:col-span-6">
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
            <div>
              <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-muted">
                Official profiles
              </p>
              <ul class="space-y-3">
                {
                  SITE.socials.map((profile) => (
                    <li>
                      <a
                        href={profile.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="group inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-body transition-colors hover:text-glow"
                      >
                        {profile.label}
                        <span
                          aria-hidden="true"
                          class="text-glow transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                        >
                          ↗
                        </span>
                        <span class="sr-only">(opens in a new tab)</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div>
              <p class="mb-4 font-mono text-xs uppercase tracking-[0.18em] text-muted">
                Electronic press kit
              </p>
              <a
                href="/press-kit/"
                class="inline-block border border-ink px-5 py-3 font-mono text-xs uppercase tracking-[0.14em] text-ink transition-colors hover:border-glow hover:text-glow"
              >
                Press kit (EPK) →
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
