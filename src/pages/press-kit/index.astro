---
import { getImage, Image } from 'astro:assets';

import pressPhoto from '../../assets/press/unplug-dancefloor.jpg';
import absentaPhoto from '../../assets/press/absenta-del-raval.jpg';
import oneiraPhoto from '../../assets/press/oneira-party.jpg';
import slowBcnPhoto from '../../assets/press/slow-bcn.jpg';
import unplugPhoto from '../../assets/press/unplug-bcn.jpg';
import BaseLayout from '../../layouts/BaseLayout.astro';
import MusicLedger from '../../components/MusicLedger.astro';
import { FEATURED_MUSIC } from '../../data/music';
import { PRESS_PHOTOS, TECH_RIDER } from '../../data/press';
import { SITE } from '../../data/site';
import {
  breadcrumbSchema,
  musicGroupSchema,
  profilePageSchema,
} from '../../lib/schema';

const pageUrl = `${SITE.url}/press-kit/`;
const jsonLd = [
  musicGroupSchema(),
  profilePageSchema(pageUrl),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE.url}/` },
    { name: 'Press kit', url: pageUrl },
  ]),
];
const profileLinks = SITE.socials;

const gallerySources: Record<string, typeof pressPhoto> = {
  'unplug-dancefloor': pressPhoto,
  'unplug-bcn': unplugPhoto,
  'absenta-del-raval': absentaPhoto,
  'slow-bcn': slowBcnPhoto,
  'oneira-party': oneiraPhoto,
};

const gallery = await Promise.all(
  PRESS_PHOTOS.map(async (photo) => {
    const full = await getImage({
      src: gallerySources[photo.id],
      width: 1600,
      format: 'webp',
      quality: 82,
    });

    return {
      ...photo,
      src: gallerySources[photo.id],
      fullSrc: full.src,
    };
  }),
);
---

<BaseLayout
  title="IVNV — Press Kit | Techno DJ, Barcelona"
  description="Electronic press kit for IVNV: bio, genres, BPM, press photo, official profiles, selected sets, photo gallery and technical rider."
  image="/images/og-press-kit.jpg"
  imageAlt="IVNV performing to a crowd at Unplug in Barcelona"
  type="website"
  jsonLd={jsonLd}
  markdown="/press-kit.md"
  current="/press-kit/"
>
  <section class="border-b border-line py-12 md:py-16 lg:py-20">
    <div class="mx-auto max-w-page px-4 md:px-8 lg:px-12">
      <p class="mb-5 font-mono text-xs uppercase tracking-[0.16em] text-glow">
        Electronic press kit
      </p>
      <h1 class="font-display text-[56px] font-extrabold uppercase leading-[0.82] tracking-[-0.03em] text-ink sm:text-[72px] lg:text-[88px]">
        Press kit
      </h1>
      <p class="mt-6 max-w-xl text-[16px] leading-[1.65] text-body">
        Bio, genres, BPM, press photo, official profiles, selected sets, a photo
        gallery and the full technical rider.
      </p>

      <div class="mt-10 grid grid-cols-1 items-start gap-10 lg:grid-cols-12 lg:gap-14">
        <div class="lg:col-span-6">
          <div class="rounded-2xl border border-line bg-gradient-to-br from-surface-raised via-surface to-base p-6 sm:p-8">
            <div class="border-b border-line pb-5">
              <p class="mb-2 font-mono text-xs uppercase tracking-[0.18em] text-glow">
                Artist dossier
              </p>
              <p class="font-display text-4xl font-extrabold uppercase tracking-tight text-ink sm:text-5xl">
                IVNV
              </p>
              <p class="mt-2 font-mono text-[12px] uppercase tracking-[0.12em] text-muted">
                Barcelona, Spain • DJ
              </p>
            </div>

            <div class="grid grid-cols-1 gap-6 border-b border-line py-6 md:grid-cols-12">
              <div class="md:col-span-7">
                <p class="mb-3 font-mono text-xs uppercase tracking-[0.16em] text-muted">
                  Genres
                </p>
                <ul class="flex flex-col gap-2 font-mono text-[12px] text-body">
                  {
                    SITE.genreTags.map((genre) => (
                      <li class="flex items-center gap-2">
                        <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 bg-glow" />
                        <span class="font-medium text-ink">{genre}</span>
                      </li>
                    ))
                  }
                </ul>
              </div>
              <div class="border-t border-line pt-4 md:col-span-5 md:border-l md:border-t-0 md:pl-5 md:pt-0">
                <p class="mb-3 font-mono text-xs uppercase tracking-[0.16em] text-muted">
                  BPM
                </p>
                <p class="font-mono text-3xl font-extrabold tracking-tight text-ink">
                  {SITE.bpm}
                </p>
              </div>
            </div>

            <div class="py-6">
              <p class="mb-3 font-mono text-xs uppercase tracking-[0.16em] text-muted">
                Full bio
              </p>
              <div class="space-y-3 text-[14px] leading-relaxed text-body sm:text-[15px]">
                {SITE.bio.map((paragraph) => <p>{paragraph}</p>)}
              </div>
            </div>

            <div class="border-t border-line pt-5">
              <a
                href="/#booking"
                class="inline-block bg-ink px-6 py-3 font-mono text-xs font-bold uppercase tracking-[0.14em] text-black transition-colors hover:bg-body"
              >
                Booking request →
              </a>
            </div>
          </div>
        </div>

        <div class="lg:col-span-6">
          <div class="overflow-hidden rounded-xl border border-line bg-surface">
            <div class="relative aspect-[4/3] overflow-hidden bg-base">
              <Image
                src={pressPhoto}
                alt="IVNV performing to a crowd at Unplug in Barcelona"
                width={1280}
                widths={[640, 960, 1280]}
                sizes="(min-width: 1024px) 45vw, 100vw"
                format="webp"
                quality={80}
                loading="eager"
                fetchpriority="high"
                class="h-full w-full object-cover"
              />
              <div
                class="absolute inset-x-3 bottom-3 flex flex-wrap items-center justify-between gap-2 rounded-lg border border-line bg-base/80 px-3 py-2 font-mono text-xs uppercase tracking-[0.14em] text-body backdrop-blur-sm"
              >
                <span>Live // Unplug, Barcelona</span>
                <span class="font-bold text-glow">Press photo</span>
              </div>
            </div>
          </div>

          <div class="mt-6 border-t border-line pt-6">
            <p class="mb-4 font-mono text-xs uppercase tracking-[0.16em] text-muted">
              Official profiles // platforms
            </p>
            <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
              {
                profileLinks.map((profile) => (
                  <a
                    href={profile.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="group inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-[0.12em] text-body transition-colors hover:text-glow"
                  >
                    {profile.label}
                    <span
                      aria-hidden="true"
                      class="text-glow transition-transform group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                    >
                      ↗
                    </span>
                    <span class="sr-only">(opens in a new tab)</span>
                  </a>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="border-b border-line py-12 md:py-16">
    <div class="mx-auto max-w-page px-4 md:px-8 lg:px-12">
      <div class="mb-8 border-b border-line pb-4">
        <p class="mb-1 font-mono text-xs uppercase tracking-[0.14em] text-glow">
          Recorded sets &amp; transmissions
        </p>
        <h2 class="font-display text-[40px] font-extrabold uppercase tracking-tight text-ink sm:text-[48px]">
          Music
        </h2>
      </div>
      <MusicLedger entries={FEATURED_MUSIC} />
    </div>
  </section>

  <section class="border-b border-line py-12 md:py-16" id="pictures">
    <div class="mx-auto max-w-page px-4 md:px-8 lg:px-12">
      <div class="mb-8 border-b border-line pb-4">
        <p class="mb-1 font-mono text-xs uppercase tracking-[0.14em] text-glow">
          Gallery // Press photos
        </p>
        <h2 class="font-display text-[40px] font-extrabold uppercase tracking-tight text-ink sm:text-[48px]">
          Pictures &amp; Approved Press Assets
        </h2>
      </div>

      <div data-carousel>
        <div class="mb-4 flex items-center justify-between gap-4">
          <p class="font-mono text-xs uppercase tracking-[0.14em]">
            <span class="font-bold text-glow">Photos // 01 – {String(gallery.length).padStart(2, '0')}</span>
            <span class="text-line-strong"> | </span>
            <span class="text-muted">Press selection</span>
          </p>
          <div class="flex items-center gap-2">
            <button
              type="button"
              data-carousel-prev
              aria-label="Previous photo"
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line bg-surface text-body transition-colors hover:border-glow hover:text-ink"
            >
              <span aria-hidden="true" class="text-glow">←</span>
            </button>
            <button
              type="button"
              data-carousel-next
              aria-label="Next photo"
              class="inline-flex h-9 w-9 items-center justify-center rounded-lg border border-line bg-surface text-body transition-colors hover:border-glow hover:text-ink"
            >
              <span aria-hidden="true" class="text-glow">→</span>
            </button>
          </div>
        </div>

        <div
          class="flex snap-x snap-mandatory gap-4 overflow-x-auto pb-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
          data-carousel-track
        >
          {
            gallery.map((photo, i) => (
              <button
                type="button"
                data-carousel-slide
                data-full={photo.fullSrc}
                data-alt={photo.alt}
                data-caption={photo.caption}
                class="group relative aspect-[4/5] min-w-[260px] shrink-0 cursor-zoom-in snap-start overflow-hidden rounded-xl border border-line bg-surface p-0 text-left lg:min-w-0 lg:flex-1"
              >
                <Image
                  src={photo.src}
                  alt={photo.alt}
                  width={560}
                  widths={[280, 560]}
                  sizes="(min-width: 1024px) 280px, 260px"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                />
                <span class="absolute inset-0 flex items-center justify-center bg-black/40 opacity-0 transition-opacity group-hover:opacity-100">
                  <span class="flex items-center gap-1.5 rounded-full border border-glow bg-black/80 px-3 py-2 font-mono text-[10px] font-bold uppercase tracking-[0.14em] text-glow">
                    Zoom <span aria-hidden="true">+</span>
                  </span>
                </span>
                <span class="absolute bottom-3 left-3 rounded border border-line bg-black/80 px-2.5 py-1 font-mono text-[10px] uppercase tracking-[0.12em] text-muted">
                  {photo.caption}
                </span>
                <span class="absolute right-3 top-3 rounded-full border border-line bg-black/80 px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-[0.12em] text-ink">
                  {String(i + 1).padStart(2, '0')} / {String(gallery.length).padStart(2, '0')}
                </span>
              </button>
            ))
          }
        </div>

        <div class="mt-4 flex items-center justify-center gap-2">
          {
            gallery.map((_, i) => (
              <button
                type="button"
                data-carousel-dot
                data-index={i}
                aria-label={`Go to photo ${i + 1}`}
                class="h-1 w-6 rounded-full bg-line transition-colors hover:bg-glow"
              ></button>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="py-12 md:py-16" id="tech-rider">
    <div class="mx-auto max-w-page px-4 md:px-8 lg:px-12">
      <div class="mb-8 border-b border-line pb-4">
        <p class="mb-1 font-mono text-xs uppercase tracking-[0.14em] text-glow">
          Stage &amp; sound specs
        </p>
        <h2 class="font-display text-[40px] font-extrabold uppercase tracking-tight text-ink sm:text-[48px]">
          Technical rider
        </h2>
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
        {
          TECH_RIDER.map((card) => (
            <div class="flex flex-col justify-between rounded-2xl border border-line bg-surface p-6">
              <div class="flex flex-col gap-4">
                <h3 class="font-display text-xl font-bold uppercase tracking-tight text-ink">
                  {card.title}
                </h3>
                <p class="rounded border border-line bg-[#1a1a1a] px-2.5 py-2 font-mono text-[11px] uppercase tracking-[0.08em] text-glow">
                  {card.note}
                </p>
                {card.items && (
                  <ul class="flex flex-col gap-2 font-mono text-[12px] text-body">
                    {
                      card.items.map((item) => (
                        <li class="flex items-center gap-2">
                          <span aria-hidden="true" class="h-1.5 w-1.5 shrink-0 bg-glow" />
                          <span class:list={[item.preferred && 'font-medium text-ink']}>
                            {item.name}
                          </span>
                          {item.preferred && (
                            <span class="font-mono text-[10px] font-bold text-glow">(Preferred)</span>
                          )}
                        </li>
                      ))
                    }
                  </ul>
                )}
                {card.description && (
                  <p class="text-[13px] leading-relaxed text-body">{card.description}</p>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div
    id="gallery-lightbox"
    role="dialog"
    aria-modal="true"
    aria-label="Photo preview"
    class="fixed inset-0 z-50 hidden items-center justify-center bg-black/95 p-2 backdrop-blur-md sm:p-4 md:p-6"
  >
    <div class="relative flex max-h-[96vh] w-full max-w-5xl flex-col overflow-hidden rounded-2xl border border-line bg-[#0e0e0e] shadow-2xl">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-[#121212] px-4 py-3 sm:px-6">
        <p class="flex min-w-0 items-center gap-2 font-mono text-[11px] uppercase tracking-[0.14em] sm:gap-3 sm:text-xs">
          <span class="shrink-0 rounded border border-glow bg-[#1c1c1c] px-2 py-0.5 font-bold text-glow" id="lightbox-counter">Shot 01 / 05</span>
          <span class="hidden truncate text-body sm:inline" id="lightbox-title"></span>
        </p>
        <button
          type="button"
          id="lightbox-close"
          aria-label="Close preview"
          class="inline-flex items-center gap-1.5 rounded border border-line bg-surface px-3 py-1.5 font-mono text-[11px] uppercase tracking-[0.12em] text-body transition-colors hover:border-glow hover:text-ink"
        >
          Close
          <span aria-hidden="true" class="text-glow">✕</span>
        </button>
      </div>

      <div class="relative flex min-h-[46vh] items-center justify-center overflow-hidden bg-[#050505] p-2 sm:min-h-[58vh] sm:p-6">
        <button
          type="button"
          id="lightbox-prev"
          aria-label="Previous photo"
          class="absolute left-3 z-20 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-black/85 text-ink backdrop-blur-sm transition-colors hover:border-glow hover:bg-glow hover:text-black sm:left-6"
        >
          <span aria-hidden="true">←</span>
        </button>
        <img id="lightbox-img" alt="" class="max-h-[62vh] w-auto max-w-full rounded border border-line object-contain" />
        <button
          type="button"
          id="lightbox-next"
          aria-label="Next photo"
          class="absolute right-3 z-20 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-black/85 text-ink backdrop-blur-sm transition-colors hover:border-glow hover:bg-glow hover:text-black sm:right-6"
        >
          <span aria-hidden="true">→</span>
        </button>
      </div>

      <div class="flex flex-col gap-3 border-t border-line bg-[#121212] px-4 py-3.5 sm:flex-row sm:items-center sm:justify-between sm:px-6">
        <p class="font-mono text-[11px] text-muted">
          <span id="lightbox-desc"></span>
        </p>
        <div class="flex items-center gap-1.5 overflow-x-auto py-1" id="lightbox-thumbs"></div>
      </div>
    </div>
  </div>

  <script is:inline src="/js/press-carousel.js" defer></script>
</BaseLayout>
