---
import { SITE, VISIBLE_NAV_LINKS } from '../data/site';

interface Props {
  current?: string;
}

const { current = '/' } = Astro.props;
const isActive = (href: string) =>
  href.startsWith('/press-kit') && current.startsWith('/press-kit');
const bookingHref = '/#booking';
const bookingNumber = String(VISIBLE_NAV_LINKS.length + 1).padStart(2, '0');
---

<header class="sticky top-0 z-50 border-b border-line bg-base">
  <div class="relative mx-auto flex h-16 max-w-page items-center px-4 md:px-8 lg:px-12">
    <a
      href="/"
      class="font-display text-2xl font-extrabold uppercase leading-none tracking-[-0.04em] text-ink transition-colors hover:text-glow"
      aria-label="IVNV — home"
    >
      IVNV
    </a>

    <nav class="ml-auto hidden items-center gap-7 md:flex" aria-label="Main navigation">
      {
        VISIBLE_NAV_LINKS.map((link) => (
          <a
            href={link.href}
            class:list={[
              'inline-flex items-center py-3 font-mono text-xs uppercase tracking-[0.14em] transition-colors',
              isActive(link.href) ? 'text-glow' : 'text-muted hover:text-ink',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={bookingHref}
        class="border border-line-strong px-4 py-2 font-mono text-xs font-bold uppercase tracking-[0.14em] text-ink transition-colors hover:border-glow hover:text-glow"
      >
        Booking
      </a>
    </nav>

    <details class="group ml-auto md:hidden" data-mobile-menu>
      <summary
        class="inline-flex cursor-pointer items-center border border-line-strong px-3 py-2 font-mono text-xs font-bold uppercase tracking-[0.14em] text-ink transition-colors group-open:border-glow group-open:text-glow"
      >
        Menu
      </summary>
      <div class="absolute inset-x-0 top-full border-b border-t border-line bg-base px-4 pb-6 pt-2 shadow-2xl">
        <nav aria-label="Mobile navigation">
          {
            VISIBLE_NAV_LINKS.map((link, index) => (
              <a
                href={link.href}
                class="flex items-center justify-between border-b border-line py-4 font-mono text-sm uppercase tracking-[0.12em] text-ink"
              >
                <span class="flex items-baseline gap-4">
                  <span class="text-xs text-muted">{String(index + 1).padStart(2, '0')}</span>
                  {link.label}
                </span>
                <span aria-hidden="true" class="text-glow">
                  →
                </span>
              </a>
            ))
          }
          <a
            href={bookingHref}
            class="flex items-center justify-between border-b border-line py-4 font-mono text-sm uppercase tracking-[0.12em] text-ink"
          >
            <span class="flex items-baseline gap-4">
              <span class="text-xs text-muted">{bookingNumber}</span>
              Booking & contact
            </span>
            <span aria-hidden="true" class="text-glow">→</span>
          </a>
        </nav>
        <a
          href={`mailto:${SITE.email}`}
          class="mt-6 inline-block font-mono text-xs uppercase tracking-[0.12em] text-glow underline decoration-line-strong underline-offset-4"
        >
          {SITE.email}
        </a>
      </div>
    </details>
  </div>
</header>

<script is:inline src="/js/menu.js" defer></script>
